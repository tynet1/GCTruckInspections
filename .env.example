# Copy to .env and fill in. Never commit .env.

# --- Database (used by the db and app containers) ---
POSTGRES_USER=gc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=gc_inspections

# --- First admin account (created on first start if no admin exists) ---
ADMIN_NAME=Tyler Longshore
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars

# --- Web ---
# The hostname people type. Caddy uses it to pick TLS:
#   :80                      plain HTTP (use this behind Cloudflare Tunnel, or for a quick LAN test)
#   inspect.example.com      Caddy gets a Let's Encrypt cert (needs ports 80/443 open to the internet)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# "auto" marks the sign-in cookie Secure when the request came in over HTTPS.
COOKIE_SECURE=auto
# Photo limits: per person per 24 hours, and the free disk space below which uploads wait on the phones.
# Leave blank for the defaults (1024 MB a day, pause under 2048 MB free).
UPLOAD_DAILY_MB=
UPLOAD_MIN_FREE_MB=
TZ=America/Phoenix

# --- Cloudflare Tunnel (optional; start with: docker compose --profile tunnel up -d) ---
# Create a tunnel in the Cloudflare Zero Trust dashboard, point its public hostname at http://caddy:80,
# and paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups ---
# Host folder for nightly backups. Point it at a second disk or a mounted NAS share. The app writes its own backup
# there too, before it changes the database during an update (db_<time>_before-migrate-NNN.dump + uploads_...tar.gz).
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
# The backup before database migrations is on unless this says "off". Leave it blank on a server: with "off", an
# update changes the database with no restore point. "off" is for development and test databases only (and goes in
# .env.local for `npm run dev` on a machine without pg_dump 16).
PRE_MIGRATE_BACKUP=

# --- Update check (optional) ---
# A GitHub repository ("owner/name") whose latest release Admin → About compares with this version, once a day, after
# an admin turns it on there. Leave blank to hide the feature (a private repository can't be checked anyway).
UPDATE_CHECK_REPO=
